<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="geekseek_fake_robot">
  <material name="dark"><color rgba="0.10 0.12 0.15 1"/></material>
  <material name="arm"><color rgba="0.18 0.55 0.88 1"/></material>
  <material name="accent"><color rgba="0.95 0.42 0.12 1"/></material>

  <xacro:macro name="link_box" params="name size xyz material">
    <link name="${name}">
      <visual><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry><material name="${material}"/></visual>
      <collision><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry></collision>
      <inertial><origin xyz="${xyz}"/><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
  </xacro:macro>

  <link name="base_link">
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.075" length="0.05"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.075" length="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0.025"/><mass value="1"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>

  <xacro:link_box name="shoulder_link" size="0.06 0.06 0.10" xyz="0 0 0.05" material="arm"/>
  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/><origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="10" velocity="1.5"/>
  </joint>

  <xacro:link_box name="upper_arm_link" size="0.045 0.045 0.16" xyz="0 0 0.08" material="arm"/>
  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/><origin xyz="0 0 0.10"/><axis xyz="0 1 0"/><limit lower="-1.6" upper="1.6" effort="10" velocity="1.5"/>
  </joint>

  <xacro:link_box name="forearm_link" size="0.04 0.04 0.14" xyz="0 0 0.07" material="arm"/>
  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0 0 0.16"/><axis xyz="0 1 0"/><limit lower="-1.7" upper="1.7" effort="10" velocity="1.5"/>
  </joint>

  <xacro:link_box name="wrist_yaw_link" size="0.05 0.05 0.05" xyz="0 0 0.025" material="accent"/>
  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_yaw_link"/><origin xyz="0 0 0.14"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="6" velocity="2"/>
  </joint>

  <xacro:link_box name="wrist_pitch_link" size="0.045 0.045 0.06" xyz="0 0 0.03" material="dark"/>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_yaw_link"/><child link="wrist_pitch_link"/><origin xyz="0 0 0.05"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="6" velocity="2"/>
  </joint>

  <link name="camera_link">
    <visual><origin xyz="0 0 0.025"/><geometry><box size="0.11 0.035 0.05"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><box size="0.11 0.035 0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0.025"/><mass value="0.15"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="camera_roll_joint" type="revolute">
    <parent link="wrist_pitch_link"/><child link="camera_link"/><origin xyz="0 0 0.06"/><axis xyz="1 0 0"/><limit lower="-1.57" upper="1.57" effort="4" velocity="2"/>
  </joint>
</robot>
