Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Name: Floor
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: Geekseek Robot
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/Marker
      Marker Topic:
        Value: /geekseek/fake_robot/debug_marker
      Name: Camera Direction and Pose
      Value: true
  Global Options:
    Background Color: 28; 30; 36
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
Window Geometry:
  Height: 800
  Width: 1200
